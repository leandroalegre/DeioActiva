# Base de datos (MySQL/MariaDB)
DATABASE_URL="mysql://deioactiva:deioactiva@localhost:3306/deioactiva"

# Servidor
PORT=3001
FRONTEND_URL="http://localhost:5173"

# JWT
JWT_ACCESS_SECRET="CAMBIAR_ESTE_VALOR_ACCESS"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="CAMBIAR_ESTE_VALOR_REFRESH"
JWT_REFRESH_EXPIRES_IN_DAYS=7

# Seed del primer usuario (super_admin)
SEED_SUPER_ADMIN_EMAIL="admin@deioactiva.local"
SEED_SUPER_ADMIN_PASSWORD="CAMBIAR_ESTA_PASSWORD"
SEED_SUPER_ADMIN_NAME="Administrador"
